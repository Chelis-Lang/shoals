def i64_mod(n: int64, p: int64) -> int64 = sub(n, mul(p, div(n, p)))
def pow2_list_32() -> List[int64] = {
  map(fn (j: int64) -> {
    init = cast(1, int64)
    two = cast(2, int64)
    fold(fn (acc: int64, unused: int64) -> mul(acc, two), init, 0 |> fn (__chelis_pipe) -> cast(__chelis_pipe, int64) |> range(j))
  }, 0 |> fn (__chelis_pipe) -> cast(__chelis_pipe, int64) |> range(cast(33, int64)))
}
def bit_at_i64(n: int64, j: int64, pow2: List[int64]) -> int64 = n |> div(index(pow2, j)) |> i64_mod(cast(2, int64))
def i64_xor_pow2(a: int64, b: int64, pow2: List[int64]) -> int64 = i64_xor_32(a, b)
def i64_xor_32(a: int64, b: int64) -> int64 = {
  zero = cast(0, int64)
  one = cast(1, int64)
  two = cast(2, int64)
  init = (zero, one, a, b)
  js = range(zero, cast(32, int64))
  final_state = fold(fn (state: (int64, int64, int64, int64), unused: int64) -> {
    acc = state.0
    pj = state.1
    ar = state.2
    br = state.3
    bit_a = i64_mod(ar, two)
    bit_b = i64_mod(br, two)
    xor_bit = bit_a |> add(bit_b) |> i64_mod(two)
    new_acc = add(acc, mul(xor_bit, pj))
    new_pj = mul(pj, two)
    new_ar = div(ar, two)
    new_br = div(br, two)
    (new_acc, new_pj, new_ar, new_br)
  }, init, js)
  final_state.0
}
def halton_value(i: int64, base: int64) -> f32 = {
  init_state = (cast(1.0, f32), cast(0.0, f32), add(i, cast(1, int64)))
  iters = 0
    |> fn (__chelis_pipe) -> cast(__chelis_pipe, int64) |> range(cast(64, int64))
  base_f = cast(base, f32)
  final = fold(fn (state: (f32, f32, int64), unused: int64) -> {
    f_acc = state.0
    x_acc = state.1
    n_acc = state.2
    if eq(n_acc, cast(0, int64)) then state else {
      f_new = div(f_acc, base_f)
      q = div(n_acc, base)
      r = sub(n_acc, mul(base, q))
      x_new = add(x_acc, mul(f_new, cast(r, f32)))
      (f_new, x_new, q)
    }
  }, init_state, iters)
  final.1
}
def sobol_value_from_slice(i: int64, dim_slice: List[int64], two_pow_32: f32) -> f32 = {
  zero = cast(0, int64)
  one = cast(1, int64)
  two = cast(2, int64)
  init = (zero, i)
  final_state = fold(fn (state: (int64, int64), vj: int64) -> {
    acc = state.0
    ir = state.1
    bit_ij = i64_mod(ir, two)
    new_acc = if eq(bit_ij, one) then i64_xor_32(acc, vj) else acc
    new_ir = div(ir, two)
    (new_acc, new_ir)
  }, init, dim_slice)
  final_state.0
  |> fn (__chelis_pipe) -> cast(__chelis_pipe, f32) |> div(two_pow_32)
}
def sobol_value(i: int64, d: int64, table: List[int64], pow2: List[int64], two_pow_32: f32) -> f32 = {
  base_idx = mul(d, cast(32, int64))
  dim_slice = table |> drop(base_idx) |> take(cast(32, int64))
  sobol_value_from_slice(i, dim_slice, two_pow_32)
}
def halton_points[total](n_points: int64, n_dims: int64) -> tensor[total, f32] = {
  primes_l = to_list(prime_table())
  idxs = 0
    |> fn (__chelis_pipe) -> cast(__chelis_pipe, int64) |> range(mul(n_points, n_dims))
  flat_l = map(fn (k: int64) -> {
    i_row = div(k, n_dims)
    d_col = sub(k, mul(n_dims, i_row))
    base = index(primes_l, d_col)
    halton_value(i_row, base)
  }, idxs)
  to_tensor(flat_l)
}
def sobol_points[total](n_points: int64, n_dims: int64) -> tensor[total, f32] = {
  table_l = to_list(sobol_direction_table())
  two_pow_32 = cast(4294967296.0, f32)
  d_idxs = 0 |> fn (__chelis_pipe) -> cast(__chelis_pipe, int64) |> range(n_dims)
  dim_slices = map(fn (d: int64) -> table_l |> drop(mul(d, cast(32, int64))) |> take(cast(32, int64)), d_idxs)
  idxs = 0
    |> fn (__chelis_pipe) -> cast(__chelis_pipe, int64) |> range(mul(n_points, n_dims))
  flat_l = map(fn (k: int64) -> {
    i_row = div(k, n_dims)
    d_col = sub(k, mul(n_dims, i_row))
    dim_slice = index(dim_slices, d_col)
    sobol_value_from_slice(i_row, dim_slice, two_pow_32)
  }, idxs)
  to_tensor(flat_l)
}
def antithetic_terminal_mean[n](payoffs_plus: tensor[n, f32], payoffs_minus: tensor[n, f32]) -> f32 = {
  pl = to_list(payoffs_plus)
  ml = to_list(payoffs_minus)
  pairs = zip(pl, ml)
  n_f = cast(numel(payoffs_plus), f32)
  s = fold(fn (acc: f32, entry: (f32, f32)) -> add(acc, 0.5
  |> fn (__chelis_pipe) -> cast(__chelis_pipe, f32) |> mul(add(entry.0, entry.1))), cast(0.0, f32), pairs)
  div(s, n_f)
}
def control_variate_terminal_mean[n](target_payoffs: tensor[n, f32], control_payoffs: tensor[n, f32], control_known_mean: f32, regression_coef: f32) -> f32 = {
  yl = to_list(target_payoffs)
  cl = to_list(control_payoffs)
  pairs = zip(yl, cl)
  n_f = cast(numel(target_payoffs), f32)
  s = fold(fn (acc: f32, entry: (f32, f32)) -> {
    y = entry.0
    c = entry.1
    adjusted = sub(y, mul(regression_coef, sub(c, control_known_mean)))
    add(acc, adjusted)
  }, cast(0.0, f32), pairs)
  div(s, n_f)
}
def stratified_terminal_mean[n](strata_means: tensor[n, f32]) -> f32 = {
  vals = to_list(strata_means)
  n_f = cast(numel(strata_means), f32)
  s = fold(fn (acc: f32, v: f32) -> add(acc, v), cast(0.0, f32), vals)
  div(s, n_f)
}
