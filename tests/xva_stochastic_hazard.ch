module Shoals.Tests.XvaStochasticHazard
import Std.Test (assert_true)
import Shoals.Cds (HazardCurve, hazard_curve_from_pillars)
import Shoals.Xva (cva_constant_hazard, xva_cva_stochastic_hazard)
def test_cva_stochastic_hazard_constant_reduces_to_constant_cva() -> unit ! { Test } = {
  h_const = cast(0.02, f32)
  recovery = cast(0.4, f32)
  discount_rate = cast(0.03, f32)
  time_grid_a = to_tensor([cast(1.0, f32), cast(2.0, f32), cast(3.0, f32), cast(4.0, f32), cast(5.0, f32)])
  time_grid_b = to_tensor([cast(1.0, f32), cast(2.0, f32), cast(3.0, f32), cast(4.0, f32), cast(5.0, f32)])
  epe_a = to_tensor([cast(10.0, f32), cast(12.0, f32), cast(11.0, f32), cast(9.0, f32), cast(8.0, f32)])
  epe_b = to_tensor([cast(10.0, f32), cast(12.0, f32), cast(11.0, f32), cast(9.0, f32), cast(8.0, f32)])
  pillars = to_tensor([cast(1.0, f32), cast(2.0, f32), cast(3.0, f32), cast(4.0, f32), cast(5.0, f32)])
  flat_hs = to_tensor([h_const, h_const, h_const, h_const, h_const])
  curve = hazard_curve_from_pillars(pillars, flat_hs)
  cva_baseline = cva_constant_hazard(time_grid_a, epe_a, h_const, recovery, discount_rate)
  cva_stoch = xva_cva_stochastic_hazard(time_grid_b, epe_b, curve, recovery, discount_rate)
  diff = sub(cva_stoch, cva_baseline)
  diff_abs = if lt(diff, cast(0.0, f32)) then neg(diff) else diff
  assert_true(lt(diff_abs, cast(0.0001, f32)), "flat HazardCurve xva_cva_stochastic_hazard matches cva_constant_hazard within 1bp absolute (same right-endpoint DF convention)")
}
def test_cva_stochastic_hazard_increasing_hazard_increases_cva() -> unit ! { Test } = {
  recovery = cast(0.4, f32)
  discount_rate = cast(0.03, f32)
  time_grid_a = to_tensor([cast(1.0, f32), cast(2.0, f32), cast(3.0, f32), cast(4.0, f32), cast(5.0, f32)])
  time_grid_b = to_tensor([cast(1.0, f32), cast(2.0, f32), cast(3.0, f32), cast(4.0, f32), cast(5.0, f32)])
  epe_a = to_tensor([cast(5.0, f32), cast(7.0, f32), cast(10.0, f32), cast(13.0, f32), cast(15.0, f32)])
  epe_b = to_tensor([cast(5.0, f32), cast(7.0, f32), cast(10.0, f32), cast(13.0, f32), cast(15.0, f32)])
  pillars_inc = to_tensor([cast(1.0, f32), cast(2.0, f32), cast(3.0, f32), cast(4.0, f32), cast(5.0, f32)])
  pillars_flat = to_tensor([cast(1.0, f32), cast(2.0, f32), cast(3.0, f32), cast(4.0, f32), cast(5.0, f32)])
  inc_hs = to_tensor([cast(0.005, f32), cast(0.015, f32), cast(0.03, f32), cast(0.05, f32), cast(0.075, f32)])
  flat_hs = to_tensor([cast(0.035, f32), cast(0.035, f32), cast(0.035, f32), cast(0.035, f32), cast(0.035, f32)])
  curve_inc = hazard_curve_from_pillars(pillars_inc, inc_hs)
  curve_flat = hazard_curve_from_pillars(pillars_flat, flat_hs)
  cva_inc = xva_cva_stochastic_hazard(time_grid_a, epe_a, curve_inc, recovery, discount_rate)
  cva_flat = xva_cva_stochastic_hazard(time_grid_b, epe_b, curve_flat, recovery, discount_rate)
  assert_true(gt(cva_inc, cva_flat), "monotone-increasing hazard with monotone-increasing EPE yields higher CVA than constant-mean hazard (back-loaded default risk hits the high-EPE tail)")
}
def test_cva_stochastic_hazard_zero_recovery_equals_lgd_full() -> unit ! { Test } = {
  discount_rate = cast(0.03, f32)
  recovery_zero = cast(0.0, f32)
  recovery_half = cast(0.5, f32)
  time_grid_a = to_tensor([cast(1.0, f32), cast(2.0, f32), cast(3.0, f32), cast(4.0, f32), cast(5.0, f32)])
  time_grid_b = to_tensor([cast(1.0, f32), cast(2.0, f32), cast(3.0, f32), cast(4.0, f32), cast(5.0, f32)])
  epe_a = to_tensor([cast(10.0, f32), cast(12.0, f32), cast(11.0, f32), cast(9.0, f32), cast(8.0, f32)])
  epe_b = to_tensor([cast(10.0, f32), cast(12.0, f32), cast(11.0, f32), cast(9.0, f32), cast(8.0, f32)])
  pillars_a = to_tensor([cast(1.0, f32), cast(3.0, f32), cast(5.0, f32), cast(7.0, f32), cast(10.0, f32)])
  pillars_b = to_tensor([cast(1.0, f32), cast(3.0, f32), cast(5.0, f32), cast(7.0, f32), cast(10.0, f32)])
  hs_a = to_tensor([cast(0.02, f32), cast(0.03, f32), cast(0.04, f32), cast(0.05, f32), cast(0.06, f32)])
  hs_b = to_tensor([cast(0.02, f32), cast(0.03, f32), cast(0.04, f32), cast(0.05, f32), cast(0.06, f32)])
  curve_a = hazard_curve_from_pillars(pillars_a, hs_a)
  curve_b = hazard_curve_from_pillars(pillars_b, hs_b)
  cva_no_recovery = xva_cva_stochastic_hazard(time_grid_a, epe_a, curve_a, recovery_zero, discount_rate)
  cva_half_recovery = xva_cva_stochastic_hazard(time_grid_b, epe_b, curve_b, recovery_half, discount_rate)
  ratio = div(cva_no_recovery, cva_half_recovery)
  diff = sub(ratio, cast(2.0, f32))
  diff_abs = if lt(diff, cast(0.0, f32)) then neg(diff) else diff
  assert_true(lt(diff_abs, cast(0.0001, f32)), "CVA(R=0) / CVA(R=0.5) = (1-0)/(1-0.5) = 2 exactly: LGD scales CVA linearly")
}
