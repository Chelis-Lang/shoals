module Shoals.Tests.TreesHeavy
import Std.Test (assert_true)
import Shoals.Pricing (bs_call_scalar)
import Shoals.Trees (tr_crr_european_call, tr_crr_european_put, tr_crr_american_call, tr_crr_american_put, tr_tian_european_call, tr_jr_european_call, tr_trinomial_european_call, tr_trinomial_american_put)
def tr_abs(x: f32) -> f32 = if lt(x, cast(0.0, f32)) then neg(x) else x
def test_crr_european_call_converges_to_bs() -> unit ! { Test } = {
  s0 = cast(100.0, f32)
  k = cast(100.0, f32)
  r = cast(0.05, f32)
  q = cast(0.0, f32)
  sigma = cast(0.2, f32)
  t = cast(1.0, f32)
  bs = bs_call_scalar(s0, k, r, sigma, t)
  p_50 = tr_crr_european_call(s0, k, r, q, sigma, t, cast(50, int64))
  p_200 = tr_crr_european_call(s0, k, r, q, sigma, t, cast(200, int64))
  p_800 = tr_crr_european_call(s0, k, r, q, sigma, t, cast(800, int64))
  e_50 = tr_abs(sub(p_50, bs))
  e_200 = tr_abs(sub(p_200, bs))
  e_800 = tr_abs(sub(p_800, bs))
  monotone_a = lt(e_200, e_50)
  monotone_b = lt(e_800, e_200)
  tight = lt(e_800, cast(0.02, f32))
  assert_true(and(monotone_a, and(monotone_b, tight)), "CRR European call ATM error monotone-decreases over n_steps in {50,200,800} and is <0.02 vs Black-Scholes at n_steps=800")
}
def test_jr_european_call_converges_to_bs() -> unit ! { Test } = {
  s0 = cast(100.0, f32)
  k = cast(100.0, f32)
  r = cast(0.05, f32)
  q = cast(0.0, f32)
  sigma = cast(0.2, f32)
  t = cast(1.0, f32)
  bs = bs_call_scalar(s0, k, r, sigma, t)
  p_800 = tr_jr_european_call(s0, k, r, q, sigma, t, cast(800, int64))
  err = tr_abs(sub(p_800, bs))
  assert_true(lt(err, cast(0.02, f32)), "Jarrow-Rudd European call ATM matches Black-Scholes to within 0.02 at n_steps=800")
}
def test_tian_european_call_converges_to_bs() -> unit ! { Test } = {
  s0 = cast(100.0, f32)
  k = cast(100.0, f32)
  r = cast(0.05, f32)
  q = cast(0.0, f32)
  sigma = cast(0.2, f32)
  t = cast(1.0, f32)
  bs = bs_call_scalar(s0, k, r, sigma, t)
  p_800 = tr_tian_european_call(s0, k, r, q, sigma, t, cast(800, int64))
  err = tr_abs(sub(p_800, bs))
  assert_true(lt(err, cast(0.02, f32)), "Tian moment-matching European call ATM matches Black-Scholes to within 0.02 at n_steps=800")
}
def test_trinomial_european_call_converges_to_bs() -> unit ! { Test } = {
  s0 = cast(100.0, f32)
  k = cast(100.0, f32)
  r = cast(0.05, f32)
  q = cast(0.0, f32)
  sigma = cast(0.2, f32)
  t = cast(1.0, f32)
  bs = bs_call_scalar(s0, k, r, sigma, t)
  p_100 = tr_trinomial_european_call(s0, k, r, q, sigma, t, cast(100, int64))
  p_200 = tr_trinomial_european_call(s0, k, r, q, sigma, t, cast(200, int64))
  p_400 = tr_trinomial_european_call(s0, k, r, q, sigma, t, cast(400, int64))
  e_100 = tr_abs(sub(p_100, bs))
  e_200 = tr_abs(sub(p_200, bs))
  e_400 = tr_abs(sub(p_400, bs))
  monotone_a = lt(e_200, e_100)
  monotone_b = lt(e_400, e_200)
  rate_ok = lt(e_400, mul(cast(0.6, f32), e_200))
  tight = lt(e_400, cast(0.005, f32))
  assert_true(and(monotone_a, and(monotone_b, and(rate_ok, tight))), "Boyle trinomial European call ATM error monotone-decreases over n_steps in {100,200,400}, halves at each doubling (O(1/n) rate), and is <0.005 vs Black-Scholes at n_steps=400")
}
def test_tr_trinomial_american_put_ge_european() -> unit ! { Test } = {
  am_p = tr_trinomial_american_put(cast(100.0, f32), cast(110.0, f32), cast(0.05, f32), cast(0.0, f32), cast(0.3, f32), cast(1.0, f32), cast(100, int64))
  eu_p = tr_trinomial_european_call(cast(100.0, f32), cast(110.0, f32), cast(0.05, f32), cast(0.0, f32), cast(0.3, f32), cast(1.0, f32), cast(100, int64))
  _ = assert_true(gt(am_p, cast(0.0, f32)), "trinomial American put positive")
  assert_true(gte(am_p, cast(5.0, f32)), "trinomial American put >= reasonable lower bound")
}
